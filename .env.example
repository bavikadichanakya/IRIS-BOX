# ==============================================================================
# IRIS-BOX: Environment Configuration Template
# Copy this file to .env before starting the server:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local LLM / Ollama Runtime Configuration
# ------------------------------------------------------------------------------
# Default OpenAI-compatible endpoint provided by Ollama
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=heretic-iris:latest

# IRIS Core Reasoning Model
IRIS_LLM_MODEL=heretic-iris:latest
# Universal Computer Operator Model (Qwen3-4B Q4_K_M)
IRIS_OPERATOR_MODEL=iris-qwen3-4b-operator
# Automatic fallback model if primary model is unavailable or overloaded
IRIS_FALLBACK_MODEL=qwen2.5:7b-instruct
IRIS_LLM_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 2. Server & Environment Settings
# ------------------------------------------------------------------------------
# Environment: local | development | production
IRIS_ENVIRONMENT=local
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Cryptographic Capability Gate & Security Tokens
# ------------------------------------------------------------------------------
# Master HMAC-SHA256 token used to sign bounded action step tickets and plans.
# Generate a cryptographically secure token (e.g. `openssl rand -hex 32`):
IRIS_MASTER_TOKEN=change-me-to-a-secure-random-token

# Optional: Port binding overrides (defaults to 8000 for FastAPI)
# IRIS_PORT=8000
# IRIS_HOST=127.0.0.1
